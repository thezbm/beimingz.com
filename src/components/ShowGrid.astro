---
import type { Show } from "../lib/shows";

interface Props {
  shows: Show[];
}

const { shows } = Astro.props;

function slug(title: string) {
  return title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

const sorted = [...shows].sort((a, b) => {
  if (a.tier == null && b.tier == null) return a.title.localeCompare(b.title);
  if (a.tier == null) return 1;
  if (b.tier == null) return -1;
  return b.tier - a.tier || a.title.localeCompare(b.title);
});
---

<ul class="poster-grid" role="list">
  {
    sorted.map((show) => (
      <li class="poster-card">
        <div class="poster-thumb">
          <img
            src={`/media/tv-posters/${slug(show.title)}.jpg`}
            alt={`${show.title} poster`}
            loading="lazy"
            width={330}
            height={495}
          />
        </div>
        <div class="poster-caption">
          <span class="poster-title">{show.title}</span>
          <span class="show-status-row">
            <span class="show-status">{show.status}</span>
            {show.tier != null && (
              <span
                class="tier-stars"
                role="img"
                aria-label={`rated ${show.tier} out of 5`}
              >
                {Array.from({ length: 5 }, (_, i) =>
                  i < (show.tier as number) ? "★" : "☆",
                ).join("")}
              </span>
            )}
          </span>
          {show.review != null ? (
            <span class="review-wrap">
              <span class="show-review">{show.review}</span>
              <span class="review-tip" aria-hidden="true">
                {show.review}
              </span>
            </span>
          ) : (
            <span class="show-review show-review-empty" aria-hidden="true" />
          )}
        </div>
      </li>
    ))
  }
</ul>

<script>
  import {
    computePosition,
    autoUpdate,
    offset,
    flip,
    shift,
  } from "@floating-ui/dom";

  const wraps = document.querySelectorAll(".review-wrap");
  for (const wrap of wraps) {
    const ref = wrap.querySelector<HTMLElement>(".show-review");
    const tip = wrap.querySelector<HTMLElement>(".review-tip");
    if (!ref || !tip) continue;

    const refEl = ref;
    const tipEl = tip;
    let cleanup = () => {};
    function update() {
      computePosition(refEl, tipEl, {
        placement: "top",
        strategy: "absolute",
        middleware: [offset(6), flip(), shift({ padding: 8 })],
      }).then(({ x, y }) => {
        tipEl.style.left = `${x}px`;
        tipEl.style.top = `${y}px`;
      });
    }
    function show() {
      tipEl.classList.add("is-visible");
      cleanup = autoUpdate(refEl, tipEl, update);
    }
    function hide() {
      tipEl.classList.remove("is-visible");
      cleanup();
    }
    refEl.addEventListener("pointerenter", show);
    refEl.addEventListener("pointerleave", hide);
  }
</script>
