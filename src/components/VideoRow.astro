---
export interface Props {
  /** Video paths, e.g. ["/media/abp-green.mp4"] */
  videos: string[];
}

const { videos } = Astro.props;
---

<div class="video-row" style={`--cols: ${videos.length}`}>
  {
    videos.map((src) => (
      <video controls preload="metadata">
        <source src={src} type="video/mp4" />
      </video>
    ))
  }
</div>
