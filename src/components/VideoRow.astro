---
export interface VideoItem {
  src: string;
  poster: string;
}

export interface Props {
  videos: VideoItem[];
}

const { videos } = Astro.props;
---

<div class="video-row">
  {
    videos.map(({ src, poster }) => (
      <video controls preload="metadata" poster={poster}>
        <source src={src} type="video/mp4" />
      </video>
    ))
  }
</div>
