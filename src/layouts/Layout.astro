---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import FileTree from "../components/FileTree.astro";
import { fileTree, isIndexRoute } from "../lib/tree";
import { ClientRouter } from "astro:transitions";
import { Menu } from "@lucide/astro";

export interface Props {
  title?: string;
  description?: string;
  path: string;
}

const { title, description, path } = Astro.props;

const siteTitle = "Beiming Zhang";
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const metaDescription = description ?? "Personal website of Beiming Zhang.";

// Build the breadcrumb string. Regular paths use `/` separators (e.g.
// ~/hobbies/climbing). When the first segment is an index page with a nested
// child, the child is shown after a ` › ` separator (e.g. ~/writings › building-this-site).
let breadcrumb: string;
if (path === "/") {
  breadcrumb = "~/readme";
} else {
  const segments = path.split("/").filter(Boolean);
  const firstIsIndex = isIndexRoute(fileTree, `/${segments[0]}`);
  if (firstIsIndex && segments.length > 1) {
    const [head, ...rest] = segments;
    breadcrumb = `~/${head} › ${rest.join("/")}`;
  } else {
    breadcrumb = `~/${segments.join("/")}`;
  }
}
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:url" content={new URL(path, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/favicon-192x192.png"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <ClientRouter />
  </head>
  <body>
    <div class="app">
      <div class="sidebar-backdrop" aria-hidden="true"></div>
      <aside class="sidebar" id="sidebar" tabindex="-1" transition:persist>
        <div class="sidebar-header">
          <strong>beimingz.com</strong>
        </div>
        <nav class="file-tree" id="sidebar-tree">
          <FileTree nodes={fileTree} currentRoute={path} />
        </nav>
        <div class="sidebar-footer">
          <a href="https://github.com/thezbm" target="_blank" rel="noopener">
            [GitHub]
          </a>
          <a
            href="https://www.linkedin.com/in/thezbm/"
            target="_blank"
            rel="noopener"
          >
            [LinkedIn]
          </a>
        </div>
      </aside>
      <main class="main">
        <div class="main-header">
          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="sidebar"
          >
            <Menu size={18} aria-hidden="true" />
            <span class="sr-only">Toggle navigation</span>
          </button>
          {breadcrumb}
        </div>
        <article class="main-content">
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>

<script>
  // On mobile the sidebar becomes an off-canvas drawer that slides in from the
  // left, opened via the menu button in the sticky header. The bundled module
  // script runs once; the body is swapped on navigation, so clicks are handled
  // with event delegation on `document` (which persists) and the open/close
  // state is reconciled on every `astro:page-load`.
  const isMobile = () => window.matchMedia("(max-width: 720px)").matches;

  function setOpen(open: boolean) {
    document.body.classList.toggle("sidebar-open", open);
    document
      .querySelector(".menu-toggle")
      ?.setAttribute("aria-expanded", String(open));
    if (open)
      (document.querySelector(".sidebar") as HTMLElement | null)?.focus();
  }

  document.addEventListener("click", (event) => {
    if (!isMobile()) return;
    const target = event.target as Element | null;
    if (!target) return;
    if (target.closest(".menu-toggle")) {
      setOpen(!document.body.classList.contains("sidebar-open"));
    } else if (target.closest(".sidebar-backdrop")) {
      setOpen(false);
    } else if (target.closest(".file-tree a")) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      document.body.classList.contains("sidebar-open")
    ) {
      setOpen(false);
      (document.querySelector(".menu-toggle") as HTMLElement | null)?.focus();
    }
  });

  document.addEventListener("astro:page-load", () => {
    setOpen(false);
  });
</script>
