---
import Layout from "../layouts/Layout.astro";
import { getEntry, render, getCollection } from "astro:content";
import { formatDate } from "../lib/format";

const entry = await getEntry("page", "writings");
if (!entry) throw new Error("Missing 'writings' content entry");
const { Content } = await render(entry);
const route = "/writings";

const posts = (await getCollection("writing")).sort(
  (a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf(),
);
---

<Layout
  title={entry.data.title}
  path={route}
  description={entry.data.description}
>
  <Content />
  <ul class="blog-list" role="list">
    {
      posts.map((post) => (
        <li>
          <a href={`/writings/${post.id}`}>{post.data.title}</a>
          {post.data.description && (
            <>
              {" — "}
              <span>{post.data.description}</span>
            </>
          )}
          <time class="date" datetime={post.data.createdAt.toISOString()}>
            {formatDate(post.data.createdAt)}
          </time>
        </li>
      ))
    }
  </ul>
</Layout>
